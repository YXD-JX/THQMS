# Enable HTTPS dev server for push/APIs on mobile LAN testing
# Set to 1 to enable https; provide cert paths if not using default locations under ./cert
VITE_DEV_HTTPS=0
# Optional: PEM cert/key paths
VITE_DEV_CERT=cert/dev-cert.pem
VITE_DEV_KEY=cert/dev-key.pem
# Optional: PFX (e.g., .p12). If set, takes precedence over PEM
VITE_DEV_PFX=
VITE_DEV_PFX_PASSPHRASE=
